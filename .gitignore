# ─────────────────────────────────────────────────────────────
# Video & large raw media  (never commit — multi-GB, licensed)
# ─────────────────────────────────────────────────────────────
data/raw/
videos/
*.mp4
*.webm
*.avi
*.mkv
*.mov

# ─────────────────────────────────────────────────────────────
# YOLOv8 model weights  (auto-downloaded by ultralytics on first run)
# ─────────────────────────────────────────────────────────────
.models/
*.pt
*.pth
*.onnx

# ─────────────────────────────────────────────────────────────
# Processed pipeline outputs
#   - raw_tracks.parquet is a large intermediate (regenerated by 01_track.py)
#   - the small precomputed files BELOW are kept so the dashboard runs
#     immediately after cloning (see the ! un-ignore rules)
# ─────────────────────────────────────────────────────────────
data/processed/raw_tracks.parquet
data/processed/raw_tracks_checkpoint.csv

# Local V2 run manifests and copied artifacts (recreated by the demo importer)
data/runs/
data/job-queue/

# V2 dashboard dependencies and generated test/build outputs
v2/dashboard/node_modules/
v2/dashboard/dist/
v2/dashboard/coverage/
v2/dashboard/test-results/
v2/dashboard/playwright-report/

# Keep the lightweight precomputed data that powers the dashboard
!data/processed/meta.json
!data/processed/player_stats.parquet
!data/processed/player_summary.json
!data/processed/risk_scores.json

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.env
.env.*
!.env.example
.venv*
venv/
env/
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Container-local runtime overrides
compose.override.yaml
docker-compose.override.yml

# Terraform local working data, plans, variables, and state (may contain secrets)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ─────────────────────────────────────────────────────────────
# Editor / OS / tooling
# ─────────────────────────────────────────────────────────────
.DS_Store
.cursor/
.idea/
.vscode/
TechincalTest_Statement.rtf
