# Deployment identity (non-secret)
FOOTBALLAI_ENVIRONMENT=local
FOOTBALLAI_LOG_LEVEL=INFO
FOOTBALLAI_CODE_REVISION=0000000000000000000000000000000000000000
FOOTBALLAI_CODE_DIRTY=0

# Backend selection. Defaults are the local adapters. Cloud values require the
# matching configuration below or startup fails fast (no silent fallback).
#   FOOTBALLAI_QUEUE_BACKEND:          local | azure_service_bus
#   FOOTBALLAI_OBJECT_STORAGE_BACKEND: local | azure_blob
#   FOOTBALLAI_DATABASE_BACKEND:       local_manifest | postgres
FOOTBALLAI_QUEUE_BACKEND=local
FOOTBALLAI_OBJECT_STORAGE_BACKEND=local
FOOTBALLAI_DATABASE_BACKEND=local_manifest
FOOTBALLAI_V2_RUN_ROOT=/var/lib/footballai/runs
FOOTBALLAI_V2_QUEUE_ROOT=/var/lib/footballai/queue

# --- P2 cloud adapters (leave blank unless the matching backend is selected) ---
# PostgreSQL control plane. The URL is a runtime secret; never commit a real one.
# Example shape (placeholder password): postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
FOOTBALLAI_DATABASE_URL=
# Azure Blob data plane. Use a connection string for the Azurite emulator in dev;
# in staging/production leave the connection string blank and set the account URL
# so DefaultAzureCredential (Managed Identity) is used instead.
FOOTBALLAI_BLOB_CONNECTION_STRING=
FOOTBALLAI_BLOB_ACCOUNT_URL=
FOOTBALLAI_BLOB_CONTAINER=footballai-runs
# Azure Service Bus queue. The connection string is a runtime secret.
FOOTBALLAI_SERVICEBUS_CONNECTION_STRING=
FOOTBALLAI_SERVICEBUS_QUEUE=footballai-jobs

# API and browser configuration
FOOTBALLAI_API_HOST=0.0.0.0
FOOTBALLAI_API_PORT=8000
FOOTBALLAI_API_WORKERS=1
FOOTBALLAI_API_GRACEFUL_TIMEOUT_SECONDS=30
FOOTBALLAI_V2_CORS_ORIGINS=http://localhost:8080
# Leave blank when the frontend and API share an origin through a reverse proxy.
FOOTBALLAI_FRONTEND_API_BASE=

# Bounded ingestion
FOOTBALLAI_MAX_UPLOAD_BYTES=262144000
FOOTBALLAI_MAX_VIDEO_DURATION_SECONDS=14400
FOOTBALLAI_ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm
FFPROBE_TIMEOUT_SECONDS=10

# Worker
FOOTBALLAI_WORKER_ID=
FOOTBALLAI_WORKER_POLL_SECONDS=0.25
FOOTBALLAI_JOB_CLAIM_TIMEOUT_SECONDS=300
FOOTBALLAI_DEMO_STAGE_DELAY_SECONDS=0.12

# Optional v1_compat runtime. Supply the weights as a read-only runtime mount.
FOOTBALLAI_APPLICATION_ROOT=/opt/footballai
FOOTBALLAI_V1_COMPAT_MODEL_PATH=/models/yolov8m.pt
FOOTBALLAI_V1_COMPAT_DEVICE=cpu
FOOTBALLAI_V1_COMPAT_TARGET_FPS=5
FOOTBALLAI_V1_COMPAT_IMAGE_SIZE=1280
FOOTBALLAI_V1_COMPAT_CONFIDENCE=0.20
FOOTBALLAI_V1_SUBPROCESS_TIMEOUT_SECONDS=7200
FOOTBALLAI_MAX_RUN_LOG_BYTES=2097152
